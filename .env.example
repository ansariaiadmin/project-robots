# project-robots — Environment Template (no secrets, local-only)
# Copy to .env: cp .env.example .env

# No secrets required — local-only, central cache
PYTHONPATH=.
# Optional: custom cache dir
# PROJECT_ROBOTS_CACHE_DIR=~/.cache/project-robots

# Optional: local LLM for critique
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3-8b
