# ============================================
# project-robots — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh
# ============================================

# No secrets required — local-only
PYTHONPATH=.
# PROJECT_ROBOTS_CACHE_DIR=~/.cache/project-robots

# --- LLM — برای نقد کد — با راهنما همون‌جا ---
# چیه؟ هوش مصنوعی برای نقد کد — مثل بازرس
# گزینه‌ها: ollama (لوکال رایگان — https://ollama.com/), openai, anthropic, mock
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3-8b
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Notification — ناتیف — جدید v3.0.0 ---
# چیه؟ وقتی مهندس تحلیل، پلان، تست می‌کنه ناتیف می‌ده
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# --- Fallback + Throttling — تاریکی روشن شد — v3.1.0 ---
# چیه؟ اگر یه پرووایدر خراب شد چی؟ fallback — اگر SMS fail شد in_app+email می‌ره — امن
# throttling چیه؟ اگر 5 SMS در 1 دقیقه بیاد خلاصه می‌شه — هزینه کنترل — spam جلوگیری
SMS_FALLBACK_PROVIDERS=ghasedak,kavenegar,mock
SMS_THROTTLING_ENABLED=true
SMS_THROTTLING_MAX_PER_MINUTE=5
NOTIF_FALLBACK_ENABLED=true
NOTIF_THROTTLING_ENABLED=true
NOTIF_THROTTLING_MAX_PER_MINUTE=10
NOTIF_THROTTLING_DIGEST_ENABLED=true
