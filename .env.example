# ============================================
# project-robots — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh
# ============================================

# No secrets required — local-only
PYTHONPATH=.
# PROJECT_ROBOTS_CACHE_DIR=~/.cache/project-robots

# --- LLM — برای نقد کد — با راهنما همون‌جا ---
# چیه؟ هوش مصنوعی برای نقد کد — مثل بازرس
# گزینه‌ها: ollama (لوکال رایگان — https://ollama.com/), openai, anthropic, mock
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3-8b
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Notification — ناتیف — جدید v3.0.0 ---
# چیه؟ وقتی مهندس تحلیل، پلان، تست می‌کنه ناتیف می‌ده
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
