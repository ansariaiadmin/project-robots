{
  "version": 1,
  "name": "PROJECT_ROBOTS",
  "requiredDocs": [
    "AGENTS.md",
    "README.md"
  ],
  "readFirst": [
    "AGENTS.md",
    "README.md"
  ],
  "invariants": [],
  "routes": [
    {
      "name": "docs",
      "keywords": [
        "docs",
        "documentation",
        "roadmap",
        "module"
      ],
      "patterns": [
        "docs/**",
        "*.md",
        "AGENTS.md"
      ],
      "readFirst": [
        "AGENTS.md",
        "README.md"
      ],
      "checks": [],
      "invariants": [
        "Documentation must match current source behavior."
      ]
    },
    {
      "name": "ui",
      "keywords": [
        "ui",
        "ux",
        "interface",
        "frontend",
        "layout"
      ],
      "patterns": [
        "src/pages/**",
        "src/components/**",
        "src/ui/**",
        "src/styles/**",
        "app/**",
        "pages/**",
        "components/**"
      ],
      "readFirst": [
        "AGENTS.md",
        "README.md"
      ],
      "checks": [],
      "invariants": []
    },
    {
      "name": "core",
      "keywords": [
        "core",
        "logic",
        "backend",
        "service",
        "storage",
        "data"
      ],
      "patterns": [
        "src/services/**",
        "src/storage/**",
        "src/data/**",
        "lib/**",
        "server/**",
        "backend/**",
        "tests/**"
      ],
      "readFirst": [
        "AGENTS.md",
        "README.md"
      ],
      "checks": [],
      "invariants": []
    },
    {
      "name": "release",
      "keywords": [
        "release",
        "deploy",
        "package",
        "docker",
        "ci",
        "build"
      ],
      "patterns": [
        "Dockerfile",
        "docker/**",
        ".github/**",
        "scripts/release/**",
        "scripts/deploy/**",
        "scripts/package*",
        "package.json",
        "package-lock.json",
        "pyproject.toml"
      ],
      "readFirst": [
        "AGENTS.md",
        "README.md"
      ],
      "checks": [],
      "invariants": []
    },
    {
      "name": "automation",
      "keywords": [
        "automation",
        "robot",
        "agent",
        "tool",
        "script"
      ],
      "patterns": [
        "scripts/**",
        "tools/**",
        "package.json",
        "pyproject.toml"
      ],
      "readFirst": [
        "AGENTS.md",
        "README.md"
      ],
      "checks": [],
      "invariants": [
        "Generated evidence must stay outside product source."
      ]
    }
  ],
  "checks": {},
  "limits": {
    "contextTokenBudget": 4000,
    "maxFindings": 40,
    "commandTimeoutSeconds": 900,
    "outputTailLines": 30
  }
}
